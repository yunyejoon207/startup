import sqlite3
import threading
from contextlib import closing

from flask import Flask, Response, jsonify, request

HOST = "127.0.0.1"
PORT = 8000
DB_FILE = "ranking.db"
MAX_NAME_LEN = 30
MAX_SCORE = 2 ** 63 - 1
MAX_BODY = 64 * 1024

write_lock = threading.Lock()

HTML = r"""<!DOCTYPE html>
