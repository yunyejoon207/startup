<body>
<div class="container">
<h1>괴산고 랭킹</h1>
<div id="msg">서버에서 랭킹을 불러오는 중...</div>
<div id="list"></div>
<button class="refresh" type="button">랭킹 새로고침</button>
<div id="updateTime" class="update-time"></div>
</div>

<script>
const list = document.getElementById("list");
const msg = document.getElementById("msg");
const updateTime = document.getElementById("updateTime");

const MEDAL = {1: "🥇", 2: "🥈", 3: "🥉"};
const RANK_CLASS = {1: "first", 2: "second", 3: "third"};

let lastData = null;
let loading = false;

function notice(text) {
    const el = document.createElement("div");
    el.className = "empty";
    el.textContent = text;
    list.replaceChildren(el);
}

function makeRow(player, rank) {
    const row = document.createElement("div");
    row.className = RANK_CLASS[rank] ? "player " + RANK_CLASS[rank] : "player";

    const rankEl = document.createElement("div");
    rankEl.className = "rank";
    rankEl.textContent = MEDAL[rank] || rank;

    const nameEl = document.createElement("div");
    nameEl.className = "name";
    nameEl.textContent = player.name;
    nameEl.title = player.name;

    const scoreEl = document.createElement("div");
    scoreEl.className = "score";
    scoreEl.textContent = player.score + "점";

    row.append(rankEl, nameEl, scoreEl);
    return row;
}

function render(ranking) {
    if (ranking.length === 0) {
        notice("등록된 랭킹이 없습니다.");
        msg.textContent = "";
        return;
    }

    const frag = document.createDocumentFragment();
    let rank = 0;
    let prevScore = null;

    ranking.forEach((player, i) => {
        if (player.score !== prevScore) {
            rank = i + 1;
            prevScore = player.score;
        }
        frag.appendChild(makeRow(player, rank));
    });

    list.replaceChildren(frag);
    msg.textContent = `총 ${ranking.length}명의 랭킹`;
}

async function loadRanking() {
    if (loading) return;
    loading = true;

    try {
        const response = await fetch("/api/ranking", {cache: "no-store"});
        if (!response.ok) throw new Error("서버 오류 " + response.status);

        const ranking = await response.json();
        const key = JSON.stringify(ranking);

        if (key !== lastData) {
            lastData = key;
            render(ranking);
        }
        updateTime.textContent = "마지막 갱신: " + new Date().toLocaleTimeString("ko-KR");

    } catch (error) {
        console.error(error);
        lastData = null;
        msg.textContent = "서버에 연결할 수 없습니다.";
        notice("서버가 실행 중인지 확인하세요.");

    } finally {
        loading = false;
    }
}

document.querySelector(".refresh").addEventListener("click", loadRanking);
loadRanking();
setInterval(loadRanking, 5000);
</script>
</body>
</html>"""


def connect():
    con = sqlite3.connect(DB_FILE, timeout=5.0)
    con.execute("PRAGMA busy_timeout = 5000")
    return closing(con)


def init_db():
    with connect() as con, con:
        con.execute("PRAGMA journal_mode = WAL")
        con.execute("""
            CREATE TABLE IF NOT EXISTS ranking (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL UNIQUE,
                score INTEGER NOT NULL
            )
        """)


def get_ranking():
    with connect() as con:
        rows = con.execute(
            "SELECT name, score FROM ranking ORDER BY score DESC, id ASC"
        ).fetchall()

    return [{"name": name, "score": score} for name, score in rows]


def add_score(name, score):
    with write_lock, connect() as con, con:
        row = con.execute(
            "SELECT score FROM ranking WHERE name = ?", (name,)
        ).fetchone()

        if row is None:
            con.execute(
                "INSERT INTO ranking(name, score) VALUES (?, ?)", (name, score)
            )
            return "created"

        if score > row[0]:
            con.execute(
                "UPDATE ranking SET score = ? WHERE name = ?", (score, name)
            )
            return "updated"

        return "unchanged"


def parse_payload(data):
    if not isinstance(data, dict):
        raise ValueError("body must be an object")

    name = data.get("name")
    score = data.get("score")

    if not isinstance(name, str):
        raise ValueError("name must be a string")

    name = name.strip()

    if not name or len(name) > MAX_NAME_LEN:
        raise ValueError("invalid name length")

    if not name.isprintable():
        raise ValueError("name contains control characters")

    if isinstance(score, bool) or not isinstance(score, int):
        raise ValueError("score must be an integer")

    if not 0 <= score <= MAX_SCORE:
        raise ValueError("score out of range")

    return name, score


MESSAGES = {
    "created": "새로운 학생의 점수가 등록되었습니다.",
    "updated": "최고 점수가 갱신되었습니다.",
    "unchanged": "기존 최고점보다 낮거나 같은 점수입니다.",
}

DB_ERROR = {"ok": False, "error": "데이터베이스 처리 중 오류가 발생했습니다."}
BAD_REQUEST = {"ok": False, "error": "name과 score를 올바르게 보내세요."}


app = Flask(__name__)
app.config["MAX_CONTENT_LENGTH"] = MAX_BODY
app.json.ensure_ascii = False


@app.after_request
def add_headers(response):
    response.headers["Cache-Control"] = "no-store"
    response.headers["Access-Control-Allow-Origin"] = "*"
    response.headers["Access-Control-Allow-Methods"] = "GET, POST, OPTIONS"
    response.headers["Access-Control-Allow-Headers"] = "Content-Type"
    response.headers["Access-Control-Max-Age"] = "86400"
    return response


@app.get("/")
def index():
    return Response(HTML, content_type="text/html; charset=utf-8")


@app.get("/api/ranking")
def read_ranking():
    try:
        return jsonify(get_ranking())
    except sqlite3.Error:
        return jsonify(DB_ERROR), 500


@app.post("/api/ranking")
def write_ranking():
    try:
        name, score = parse_payload(request.get_json(silent=True))
    except (ValueError, TypeError):
        return jsonify(BAD_REQUEST), 400

    try:
        result = add_score(name, score)
        ranking = get_ranking()
    except sqlite3.Error:
        return jsonify(DB_ERROR), 500

    return jsonify({
        "ok": True,
        "result": result,
        "message": MESSAGES[result],
        "ranking": ranking,
    })


@app.errorhandler(413)
def body_too_large(error):
    return jsonify({"ok": False, "error": "요청 본문이 너무 큽니다."}), 413


if __name__ == "__main__":
    init_db()

    print("=" * 50)
    print("괴산고 랭킹 서버가 실행되었습니다. (Flask)")
    print()
    print(f"브라우저: http://{HOST}:{PORT}")
    print()
    print("GET  /api/ranking")
    print("POST /api/ranking   {\"name\": \"홍길동\", \"score\": 100}")
    print()
    print("종료: Ctrl + C")
    print("=" * 50)

    app.run(host=HOST, port=PORT, threaded=True)
